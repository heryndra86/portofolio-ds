{
  "name": "Gifhari portfolio",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Portfolio preview",
      "onAutoForward": "openPreview"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8000 --bind 0.0.0.0 --directory dist >/tmp/gifhari-portfolio-preview.log 2>&1 &"
}
